# Copy to .env and fill in. Never commit .env.

# --- Used by docker compose for the PostgreSQL password (and the URLs inside the containers) ---
# POSTGRES_PASSWORD=change-me   # if you change it, change the passwords in the two URLs below too

# --- Runtime database (event log, leases, timers, signals) ---
DATABASE_URL=postgresql+asyncpg://durable:durable@localhost:5432/durable

# --- Fake external services keep their OWN ledger, separate from the runtime DB ---
SERVICES_DATABASE_URL=postgresql+asyncpg://durable:durable@localhost:5432/fake_services

# --- Worker / lease tuning (seconds) ---
LEASE_DURATION_SECONDS=15
HEARTBEAT_INTERVAL_SECONDS=5
WORKER_POLL_INTERVAL_SECONDS=1

# --- LLM provider: "mock" (default, free, for tests) or "openai" ---
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: USD per 1M tokens, from OpenAI's pricing page. Leave empty to record cost as unknown.
OPENAI_INPUT_PRICE_PER_1M=
OPENAI_OUTPUT_PRICE_PER_1M=

# --- Retries for plain steps and LLM calls on transient failures (never for external effects) ---
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=30
RETRY_JITTER=0.2
# STEP_TIMEOUT_SECONDS=60   # per-attempt limit; unset = no limit

# --- Idle worker polling ---
WORKER_POLL_BACKOFF_FACTOR=1.5
WORKER_POLL_MAX_INTERVAL_SECONDS=5
WORKER_POLL_JITTER=0.2
WORKER_TOUCH_INTERVAL_SECONDS=5

# --- API authentication: comma-separated keys. Leave both empty only for local development. ---
#   operator keys can read and write; read-only keys can only GET.
#   Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_OPERATOR_KEYS=
API_READONLY_KEYS=

# --- API ---
LOG_LEVEL=INFO
