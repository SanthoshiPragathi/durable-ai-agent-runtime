# Copy to .env and fill in. Never commit .env.

# --- Runtime database (event log, leases, timers, signals) ---
DATABASE_URL=postgresql+psycopg://durable:durable@localhost:5432/durable

# --- Fake external services keep their OWN ledger, separate from the runtime DB ---
SERVICES_DATABASE_URL=postgresql+psycopg://durable:durable@localhost:5432/fake_services

# --- Worker / lease tuning (seconds) ---
LEASE_DURATION_SECONDS=15
HEARTBEAT_INTERVAL_SECONDS=5
WORKER_POLL_INTERVAL_SECONDS=1

# --- LLM provider: "mock" (default, free, for tests) or "openai" ---
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- API ---
LOG_LEVEL=INFO
